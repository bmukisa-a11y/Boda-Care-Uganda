# ==============================================================================
# BODACARE UGANDA (E BODA CONNECT LUWEERO) — ENVIRONMENT VARIABLES
# ==============================================================================
# NOTE: No API keys are required to run, preview, or deploy the core platform.
# All third-party integrations below are OPTIONAL until you obtain credentials.
# Never expose secret keys in frontend code or commit real .env files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ESSENTIAL / CORE RUNTIME VARIABLES (Auto-provided or Safe Defaults)
# ------------------------------------------------------------------------------
# HTTP server port (defaults to 3000 if unset)
PORT="3000"

# Public URL of your deployed app (used in SMS/WhatsApp job deep links).
# Auto-detected from request host if left empty.
APP_URL=""

# ------------------------------------------------------------------------------
# 2. OPTIONAL — AFRICA'S TALKING BULK SMS GATEWAY (Uganda MTN & Airtel)
# Obtain from: https://account.africastalking.com -> Settings -> API Key
# Leave blank to run BodaCare using In-App Notifications & USSD-ready queue.
# ------------------------------------------------------------------------------
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_ENV="production"
AFRICASTALKING_SENDER_ID="BODACARE"
AFRICASTALKING_SENDER_APPROVED="false"
SMS_COST_PER_SEGMENT_UGX="35"

# ------------------------------------------------------------------------------
# 3. OPTIONAL — META WHATSAPP BUSINESS CLOUD API
# Obtain from: https://developers.facebook.com -> WhatsApp -> API Setup
# Leave blank to disable automated WhatsApp sending without affecting the app.
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ------------------------------------------------------------------------------
# 4. OPTIONAL — USSD SHORTCODE GATEWAY (Africa's Talking / UCC Uganda)
# Obtain from: Uganda telecom / Africa's Talking USSD provisioning (*284*...#)
# Callback webhook route already active at: /api/ussd/callback
# ------------------------------------------------------------------------------
USSD_SERVICE_CODE=""

# ------------------------------------------------------------------------------
# 5. OPTIONAL — AUTOMATED DAILY JOB DISCOVERY SEARCH ENGINE APIS
# Note: Public RSS feeds, JSON APIs (ReliefWeb), & Newspaper webhooks work
# without these keys. Configure ONE below for Google search-indexed discovery.
# Obtain Google CSE: https://developers.google.com/custom-search/v1/overview
# Obtain SerpApi: https://serpapi.com/manage-api-key
# ------------------------------------------------------------------------------
GOOGLE_CSE_API_KEY=""
GOOGLE_CSE_CX=""
SERPAPI_KEY=""

# ------------------------------------------------------------------------------
# 6. OPTIONAL — GEMINI AI STRUCTURED JOB FIELD EXTRACTION
# AI Studio automatically injects this when configured in Secrets.
# Leave blank to use built-in deterministic RSS/JSON/Schema.org extraction.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 7. OPTIONAL — ANDROID / WEB PUSH NOTIFICATIONS (VAPID KEYS)
# If left empty, the server automatically generates & stores a secure P-256
# VAPID keypair in its database so Android PWA push notifications work immediately.
# For fixed multi-instance deployment, generate with: npx web-push generate-vapid-keys
# Never expose VAPID_PRIVATE_KEY to frontend VITE_* variables.
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:bmukisa@bodawerk.co.ug"

# ------------------------------------------------------------------------------
# 8. OPTIONAL — SUPER ADMIN AUTHENTICATION & SESSION SIGNING
# Leave SUPER_ADMIN_PASSCODE empty to set Brian Mukisa's passcode securely inside
# the Super Admin panel on first run (stored scrypt-hashed in SQLite).
# If SESSION_SECRET is empty, a random per-process cryptographic key is generated.
# ------------------------------------------------------------------------------
SESSION_SECRET=""
SUPER_ADMIN_PASSCODE=""


